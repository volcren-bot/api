{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"paths": {
			"$src/*": ["./src/*"],
			"$lib/*": ["./src/lib/*"]
		},
		"types": ["bun-types"],
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src", "build.ts", "environment.d.ts"]
}
